{
  "name": "reinos-ancestrales",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --configLoader runner",
    "server": "node server/index.js",
    "start": "concurrently \"npm run server\" \"npm run dev\"",
    "build": "tsc --noEmit && vite build --configLoader runner",
    "preview": "vite preview --configLoader runner",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write src/",
    "format:check": "prettier --check src/",
    "test": "vitest run --configLoader runner",
    "test:watch": "vitest --configLoader runner",
    "test:coverage": "vitest run --coverage --configLoader runner",
    "check": "npm run lint && npm run format:check && tsc --noEmit && npm run test"
  },
  "dependencies": {
    "three": "^0.179.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.28.0",
    "@types/three": "^0.179.0",
    "@vitest/coverage-v8": "^3.2.1",
    "concurrently": "^10.0.3",
    "eslint": "^9.28.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-prettier": "^5.4.1",
    "jsdom": "^29.1.1",
    "prettier": "^3.5.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.34.0",
    "vite": "^7.1.3",
    "vitest": "^3.2.1"
  }
}
